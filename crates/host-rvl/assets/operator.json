{
  "schema_version": "operator.v0",
  "name": "rvl",
  "version": "0.7.1",
  "description": "Numeric change explainer -- finds the smallest set of cell-level changes that account for the difference between two CSV files",
  "repository": "https://github.com/cmdrvl/rvl",
  "license": "MIT",
  "agent_guide": "https://github.com/cmdrvl/.github/blob/main/profile/AGENT_PROMPT.md",
  "invocation": {
    "binary": "host-rvl",
    "usage": [
      "POST /v1/run"
    ],
    "output_mode": "json",
    "output_schema": "rvl.v0"
  },
  "arguments": [
    {
      "name": "old",
      "type": "file_input",
      "required": true,
      "description": "Old CSV as an inline_base64 or kovrex_file artifact"
    },
    {
      "name": "new",
      "type": "file_input",
      "required": true,
      "description": "New CSV as an inline_base64 or kovrex_file artifact"
    }
  ],
  "options": [
    {
      "name": "key",
      "type": "string",
      "description": "Align rows by this key column (otherwise align by row order)"
    },
    {
      "name": "threshold",
      "type": "float",
      "default": 0.95,
      "description": "Coverage target: 0 < x <= 1"
    },
    {
      "name": "tolerance",
      "type": "float",
      "default": 1e-9,
      "description": "Per-cell noise floor: x >= 0"
    },
    {
      "name": "delimiter",
      "type": "string",
      "description": "Force CSV delimiter (comma/tab/semicolon/pipe/caret, 0xNN, or single ASCII byte)"
    },
    {
      "name": "profile",
      "type": "file_input",
      "description": "Optional profile YAML as an inline_base64 or kovrex_file artifact; host filesystem profile IDs are not accepted"
    },
    {
      "name": "explicit",
      "type": "flag",
      "description": "Show raw data values in output (default: redacted for zero-retention safety)"
    }
  ],
  "exit_codes": {
    "0": {
      "meaning": "NO_REAL_CHANGE",
      "domain": "positive"
    },
    "1": {
      "meaning": "REAL_CHANGE",
      "domain": "negative"
    },
    "2": {
      "meaning": "REFUSAL / CLI error",
      "domain": "error"
    }
  },
  "refusals": [
    {
      "code": "E_IO",
      "message": "Cannot read input file",
      "action": "escalate"
    },
    {
      "code": "E_ENCODING",
      "message": "Unsupported text encoding (UTF-16/32 BOM or NUL bytes)",
      "action": "escalate"
    },
    {
      "code": "E_CSV_PARSE",
      "message": "CSV parse failure",
      "action": "escalate"
    },
    {
      "code": "E_HEADERS",
      "message": "Invalid or duplicate headers",
      "action": "escalate"
    },
    {
      "code": "E_NO_KEY",
      "message": "Key column missing from file",
      "action": "retry_with_flag",
      "flag": "--key"
    },
    {
      "code": "E_KEY_EMPTY",
      "message": "Empty key value in row",
      "action": "escalate"
    },
    {
      "code": "E_KEY_DUP",
      "message": "Duplicate key values (non-unique)",
      "action": "escalate"
    },
    {
      "code": "E_KEY_MISMATCH",
      "message": "Key sets differ between files",
      "action": "escalate"
    },
    {
      "code": "E_ROWCOUNT",
      "message": "Row count mismatch and no key provided",
      "action": "retry_with_flag",
      "flag": "--key"
    },
    {
      "code": "E_NEED_KEY",
      "message": "Cannot deterministically align without a key",
      "action": "retry_with_flag",
      "flag": "--key"
    },
    {
      "code": "E_DIALECT",
      "message": "Delimiter ambiguous or undetectable",
      "action": "retry_with_flag",
      "flag": "--delimiter"
    },
    {
      "code": "E_AMBIGUOUS_PROFILE",
      "message": "Both --profile and --profile-id were provided",
      "action": "adjust_input"
    },
    {
      "code": "E_PROFILE_NOT_FOUND",
      "message": "Profile could not be resolved from ID",
      "action": "escalate"
    },
    {
      "code": "E_KEY_CONFLICT",
      "message": "--key flag conflicts with profile-defined key",
      "action": "adjust_input"
    },
    {
      "code": "E_MIXED_TYPES",
      "message": "Mixed numeric and non-numeric values in column",
      "action": "escalate"
    },
    {
      "code": "E_NO_NUMERIC",
      "message": "No numeric columns in common",
      "action": "escalate"
    },
    {
      "code": "E_MISSINGNESS",
      "message": "Numeric-vs-missing mismatch",
      "action": "escalate"
    },
    {
      "code": "E_DIFFUSE",
      "message": "Diffuse change below coverage threshold",
      "action": "retry_with_flag",
      "flag": "--threshold"
    }
  ],
  "capabilities": {
    "formats": [
      "csv"
    ],
    "profile_aware": true,
    "streaming": false
  },
  "pipeline": {
    "upstream": [
      "shape",
      "profile"
    ],
    "downstream": [
      "pack"
    ]
  }
}
