{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/deploy/railway/shape.Dockerfile",
    "watchPatterns": [
      "/Cargo.toml",
      "/Cargo.lock",
      "/.dockerignore",
      "/crates/host-core/**",
      "/crates/host-shape/**",
      "/deploy/railway/shape.Dockerfile",
      "/deploy/railway/shape.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
